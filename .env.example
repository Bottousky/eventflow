# EventFlow environment variables. Copy to .env (which is gitignored) and
# adjust to taste. Every key has a sensible default in internal/config.

# API listen address (default ":8080")
HTTP_ADDR=:8080

# SQLite database file shared by the API and worker (default "eventflow.db")
DB_PATH=eventflow.db

# Send attempts before a delivery is dead-lettered (default 3)
MAX_ATTEMPTS=3

# Max in-flight ordering-key partitions per batch (default 4)
WORKER_CONCURRENCY=4

# Wait between empty stream polls (default 500ms)
POLL_INTERVAL=500ms

# First retry backoff, doubled per attempt, capped at 2s (default 100ms)
BASE_BACKOFF=100ms

# slog log level: debug|info|warn|error (default info)
LOG_LEVEL=info
